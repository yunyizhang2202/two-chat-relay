{
  "manifest_version": 3,
  "name": "AI 对话接力 · Two-Chat Relay",
  "version": "1.0.0",
  "description": "在两个选定的聊天标签页之间自动接力交流，支持自由开场、无限次数和可选的长度控制。",
  "minimum_chrome_version": "120",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "relay_core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI 对话接力"
  }
}
